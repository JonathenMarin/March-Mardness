<<hist_womens, message=FALSE, warning=FALSE, echo=FALSE, fig.align='center', fig.cap="Distribution of Women's Regular Season Scores", fig.width=7, fig.height=5, out.width="0.8\\textwidth", fig.pos='H'>>=
womens_all_scores <- data.frame(
  Points = c(womens_results$WScore, womens_results$LScore)
)

ggplot(womens_all_scores, aes(x = Points)) +
  geom_histogram(aes(y = ..density..), bins = 50,
                 fill = "#56B1F7", color = "white") +
  stat_function(fun  = dnorm,
                args = list(mean = mean(womens_all_scores$Points),
                            sd   = sd(womens_all_scores$Points)),
                color = "#132B43", linewidth = 1.2) +
