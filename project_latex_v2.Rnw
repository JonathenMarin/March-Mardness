prediction_data_2023_womens$Pred <- predict(womens_model_2023, newdata = prediction_data_2023_womens, type = "response")

combined_report_2023 <- bind_rows(prediction_data_2023_mens, prediction_data_2023_womens) %>% 
  mutate(
