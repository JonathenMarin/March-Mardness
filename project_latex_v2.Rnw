                args = list(mean = mean(mens_all_scores$Points),
                            sd   = sd(mens_all_scores$Points)),
                color = "#132B43", linewidth = 1.2) +
  labs(title    = "Men's Regular Season Score Distribution",
       subtitle = paste0("Mean = ", round(mean(mens_all_scores$Points), 1),
                         ",  SD = ", round(sd(mens_all_scores$Points), 1),
                         ",  n = ", format(nrow(mens_all_scores), big.mark = ",")),
       x = "Points Scored",
