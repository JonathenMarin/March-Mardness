submission_2026_mens     <- fread("Excel_Files/submission_2026_model3_mens.csv")
submission_2026_womens   <- fread("Excel_Files/submission_2026_model3_womens.csv")

submission_2026_combined <- bind_rows(submission_2026_mens, submission_2026_womens)

write.csv(submission_2026_combined, "Excel_Files/submission_2026_model3_combined.csv", row.names = FALSE)

cat("Combined submission written:", nrow(submission_2026_combined), "rows\n")
cat("  Mens matchups:  ", nrow(submission_2026_mens),   "\n")
cat("  Womens matchups:", nrow(submission_2026_womens), "\n")
cat("Pred range: [", round(min(submission_2026_combined$Pred), 4), ",",
    round(max(submission_2026_combined$Pred), 4), "]\n")
@

\usubsubsection{2026 Retraining}
The Linear Regression Monte Carlo model was retrained on the 2026 regular season data prior to submission, following the same pipeline described in the Methods section. The men's model was trained on $11,236$ observations across six features and the women's model was trained on $10,900$ observations across five features, both reflecting a full 2026 regular season. The linearity, normality, and homoscedasticity assumptions were verified through diagnostic plots and were consistent with the 2025 findings. The collinearity structure, however, showed a notable change in the men's model. The VIF analysis, presented in Figure \ref{fig:vif_2026}, reveals that both \texttt{Diff\_NetRtg} and \texttt{Diff\_Elo} now register in the moderate range, with \texttt{Diff\_NetRtg} at approximately $8.0$ and \texttt{Diff\_Elo} at approximately $5.5$, compared to $7.5$ and below $5$ respectively in 2025. Both values remain below the problematic threshold of $10$, so the coefficient estimates remain valid, but the increased collinearity between these two features is a known limitation of the 2026 men's model. The women's model VIF structure remained clean with all values below $5$, consistent with 2025.

<<vif_2026, message=FALSE, warning=FALSE, echo=FALSE, fig.keep='last', fig.align='center', fig.cap="VIF Plots for the Men's and Women's 2026 Linear Regression Models", fig.width=14, fig.height=6, out.width="\\textwidth", fig.pos='H'>>=


p_mens   <- plot(check_model(model,        check = "vif"))[[1]]
p_womens <- plot(check_model(womens_model, check = "vif"))[[1]]

grid.arrange(
  p_mens   + theme(axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5)),
  p_womens + theme(axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5)),
  ncol = 2
)
@

The 2026 men's model produced several notable differences from the 2025 version. Most significantly, \texttt{Diff\_Elo} reached statistical significance at the $0.001$ level ($p = 0.000101$) with a negative coefficient of $-0.003569$, reversing the positive but insignificant direction observed in 2025. This suggests that in the 2026 season, after controlling for KenPom efficiency ratings and net rating differential, teams with historically higher Elo ratings relative to their opponents scored slightly fewer points than expected, a possible reflection of season specific regression toward the mean for historically dominant programs. \texttt{Diff\_NetRtg} also strengthened considerably, with its coefficient rising from $0.05398$ in 2025 to $0.1284$ in 2026 and reaching significance at the $0.001$ level. The $R^2$ improved modestly to $0.4021$ from $0.379$, and $\sigma$ increased slightly to $9.676$ from $9.507$.

The 2026 women's model remained structurally consistent with its 2025 counterpart. All five predictors reached statistical significance, with \texttt{OffRating} ($\hat{\beta} = 0.7369$), \texttt{DefRating} ($\hat{\beta} = 0.7750$), \texttt{AdjT\_team} ($\hat{\beta} = 0.9290$), \texttt{AdjT\_opp} ($\hat{\beta} = 0.8534$), and \texttt{Diff\_Elo} ($\hat{\beta} = 0.002479$, $p < 0.001$) all performing consistently with their 2025 estimates. The efficiency coefficients are nearly identical to the 2025 values of $0.7309$ and $0.7866$ respectively, suggesting that the relationship between Bart Torvik efficiency ratings and scoring is stable across seasons. The $R^2$ improved slightly to $0.531$ from $0.524$, and $\sigma$ increased marginally to $9.413$ from $9.300$, indicating comparable predictive precision to the prior year. The stability of the women's model across both seasons reinforces the reliability of the Bart Torvik efficiency framework as a consistent predictor of women's tournament scoring.


<<mens_table_2026, echo=FALSE, results='asis', message=FALSE, warning=FALSE>>=
library(xtable)

# Extract coefficients
mens_df_2026 <- as.data.frame(summary(model)$coefficients)
mens_df_2026 <- data.frame(Variable = rownames(mens_df_2026), mens_df_2026)
rownames(mens_df_2026) <- NULL

# Rename raw columns so we can use them easily
colnames(mens_df_2026) <- c("Variable", "Estimate", "Std. Error", "t_value", "p-value")

# Add the Sig. column based on p-values
mens_df_2026$Sig. <- ifelse(mens_df_2026$`p-value` < 0.001, "***",
                     ifelse(mens_df_2026$`p-value` < 0.01, "**",
                     ifelse(mens_df_2026$`p-value` < 0.05, "*", "")))

# Keep only the columns you specifically requested
mens_df_2026 <- mens_df_2026[, c("Variable", "Estimate", "Std. Error", "p-value", "Sig.")]

print(xtable(mens_df_2026,
             caption = "Linear Regression Coefficient Estimates (Men’s 2026 Model).",
             label   = "tab:mens_coef_2026",
             digits  = c(0, 0, 4, 4, 4, 0)), # Formats numeric columns to 4 decimals
      include.rownames  = FALSE,
      caption.placement = "bottom")
@

